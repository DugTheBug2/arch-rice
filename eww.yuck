(defwidget taskbar []
  (centerbox :orientation "h"

    (music)
    (music)
    (bar)))

(defwidget music []
    (button
      :class "wow"
      :onclick "firefox"  
      "music" 
    )
)
(defwidget bar []
  (box
    :space-evenly false :halign "end"
    :class "side_stuff"
    (button
      :class "wow"
      :onclick "pamixer -d 5"  
      :onrightclick "pamixer -i 5"
      volume
    )
    (button
      :class "power"
      :onclick "firefox"
      time 
       )
    (button
      :class "power"
      :onclick "shutdown now"  
      "⏻" 
    )
 


  )
)

(defpoll 
  time :interval "1s"
  "date '+%H:%M %b %d, %Y'")
(defpoll 
  volume :interval "0.1s"
  "pamixer --get-volume")
(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry 
                      
                      :width "95%"
                      :height "35px"
                    :anchor "top center")
  (taskbar))

    