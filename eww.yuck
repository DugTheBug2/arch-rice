(defwidget sidestuff[]
  (box 
    :orientation "h"
    :spacing 10
    :space-evenly false
    (button
      :hexpand false
      :class "power"
      :width 120
      :halign "end"
      :valign "center"
      :orientation "h"
      "⏻"
    ) 

 
  ))
(defwidget bar []
  (centerbox :orientation "h"
    (workspaces)
    (music)
    (sidestuff)))
(defwidget pc_info []
  (box
    :class "dinfo"
    :orientation "horizontal"
   "${hname}"
  "${uname}"
  )
)




(defpoll time :interval "10s"
  "date '+%H:%M %b %d, %Y'")
(defpoll hname :interval "1h"
  "hostname -s")
(defpoll uname :interval "1h"
  "whoami")

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry 
                      :width "90%"
                      :height "35px"
                      :anchor "top center")

  (sidestuff))

